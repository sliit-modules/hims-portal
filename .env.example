# ==============================================================================
# MediSure Lanka Insurance PLC - Health Insurance Management System (HIMS)
# Environment Variables Example Template (.env.example)
# ------------------------------------------------------------------------------
# Usage:
# Copy this file to '.env' in the project root and replace placeholders with
# your local MySQL credentials. '.env' is ignored by Git.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/hims_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# File Storage
APP_UPLOAD_DIR=uploads

# Logging Level
LOG_LEVEL=INFO
