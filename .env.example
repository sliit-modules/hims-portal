# ==============================================================================
# MediSure Lanka Insurance PLC - Health Insurance Management System (HIMS)
# Environment Variables Example Template (.env.example)
# ------------------------------------------------------------------------------
# NOTE: Spring Boot does NOT read .env files on its own — there is no dotenv
# library on the classpath. Copying this file to '.env' alone will have no
# effect. These are the names of the *real environment variables* the app reads,
# so export them in your shell, or set them in your IDE's run configuration:
#
#   export DB_USERNAME=root
#   export DB_PASSWORD=your_mysql_password_here
#   mvn spring-boot:run
#
# IntelliJ: Run > Edit Configurations > Environment variables.
#
# For most local development it is simpler to copy
# 'src/main/resources/application.yml.example' to 'application.yml' and edit the
# credentials there — that file is git-ignored.
# ==============================================================================

# Database credentials. Everything else (port, JDBC url, upload directory) is
# configured directly in application.yml.
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# REQUIRED: AES-256 key for medical data at rest (generate: openssl rand -base64 32).
# Keep a copy in a password manager; without it the medical data cannot be read.
HIMS_FIELD_KEY=

# Optional: online payments through the PayHere sandbox (see docs/features/payment-management.md)
PAYHERE_ENABLED=false
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
