# ==============================================================================
# MediSure Lanka Insurance PLC - Health Insurance Management System (HIMS)
# Example Application Configuration Template
# ------------------------------------------------------------------------------
# INSTRUCTIONS:
# 1. Copy this file to 'src/main/resources/application.yml'
#    (or configure equivalent system environment variables).
# 2. Update the database username and password with your local MySQL credentials.
# 3. 'application.yml' is ignored by Git to protect sensitive credentials.
# ==============================================================================

server:
  port: 8080

spring:
  application:
    name: hims-portal

  datasource:
    url: jdbc:mysql://localhost:3306/hims_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
    username: ${DB_USERNAME:root}
    password: ${DB_PASSWORD:your_mysql_password_here}
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: false
    properties:
      hibernate:
        format_sql: true
        dialect: org.hibernate.dialect.MySQLDialect
    open-in-view: true

  thymeleaf:
    cache: false

  servlet:
    multipart:
      max-file-size: 5MB
      max-request-size: 25MB

app:
  # Claim supporting documents are stored in this directory
  upload-dir: uploads

# Online premium payments through PayHere (https://sandbox.payhere.lk for testing).
# Leave enabled: false to keep payments recorded inside the portal only.
# Never commit real values: set them here in your local application.yml (ignored by Git)
# or as environment variables.
payhere:
  enabled: ${PAYHERE_ENABLED:false}
  sandbox: true
  # Integrations > Add Domain/App (domain "localhost" for local testing)
  merchant-id: ${PAYHERE_MERCHANT_ID:}
  merchant-secret: ${PAYHERE_MERCHANT_SECRET:}
  # Settings > API Keys, with only the "Payment Retrieval API" permission
  app-id: ${PAYHERE_APP_ID:}
  app-secret: ${PAYHERE_APP_SECRET:}
  # How members' browsers reach this app, for PayHere's return and cancel links
  app-base-url: http://localhost:8080
  # Optional public URL for PayHere's server-to-server notification (needed once the app is online)
  notify-url:

logging:
  level:
    com.medisure.hims: INFO
